{
  "buildCommand": "cd frontend && npm install && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "frontend/dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/public/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}